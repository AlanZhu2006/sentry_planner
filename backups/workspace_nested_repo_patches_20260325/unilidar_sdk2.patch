-/**
- * @brief Unitree Lidar SDK Node
- */
-class UnitreeLidarRosNode
-{
-protected:
-    // ROS
-    ros::NodeHandle nh_;
-    ros::Publisher pub_pointcloud_raw_;
-    ros::Publisher pub_imu_;
-    tf::TransformBroadcaster tfbc1_;
