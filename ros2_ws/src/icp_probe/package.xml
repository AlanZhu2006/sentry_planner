<?xml version="1.0"?>
<package format="3">
  <name>icp_probe</name>
  <version>0.1.0</version>
  <description>Guarded GICP localization against a PCD map with map-to-odom TF output.</description>
  <maintainer email="shanghai.robotics@nyu.edu">NYUSH Robotics Club</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>geometry_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
