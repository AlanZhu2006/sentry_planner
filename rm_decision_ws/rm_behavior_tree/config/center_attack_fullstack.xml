<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="BehaviorTree">
  <BehaviorTree ID="BehaviorTree">
    <ReactiveSequence>
      <SubArmors topic_name="/detector/armors"
                 armors="{armors}"/>
      <SubRobotStatus topic_name="robot_status"
                      robot_status="{robot_status}"/>
      <SubGameStatus topic_name="game_status"
                     game_status="{game_status}"/>
      <WhileDoElse name="GameFighting">
        <IsGameTime name="IsGameFight"
                    message="{game_status}"
                    game_progress="4"
                    lower_remain_time="0"
                    higher_remain_time="300"/>
        <WhileDoElse name="FightHealthy">
          <IsStatusOK message="{robot_status}"
                      hp_threshold="250"
                      heat_threshold="350"/>
          <WhileDoElse name="HoldCenterIfReached">
            <ReactiveSequence>
              <GetCurrentLocation current_location="{current_location}"/>
              <IsNearGoal current_location="{current_location}"
                          goal_pose="{end_goal_pose}"
                          dist_threshold="0.35"/>
            </ReactiveSequence>
            <RobotControl stop_gimbal_scan="True"
                          chassis_spin_vel="1.0"
                          scan_enabled="True"
                          allow_vision_control="True"
                          search_when_target_lost="True"
                          scan_yaw_rate_deg_s="60.0"
                          search_pitch_deg="-6.0"/>
            <WhileDoElse name="EngageEnemyOnApproach">
              <IsDetectEnemy message="{armors}"/>
              <RobotControl stop_gimbal_scan="True"
                            chassis_spin_vel="1.0"
                            scan_enabled="True"
                            allow_vision_control="True"
                            search_when_target_lost="True"
                            scan_yaw_rate_deg_s="60.0"
                            search_pitch_deg="-6.0"/>
              <ReactiveSequence>
                <RobotControl stop_gimbal_scan="True"
                              chassis_spin_vel="0.0"
                              scan_enabled="True"
                              allow_vision_control="True"
                              search_when_target_lost="True"
                              scan_yaw_rate_deg_s="60.0"
                              search_pitch_deg="-6.0"/>
                <RateController hz="1">
                  <SendGoal name="CenterNearTest"
                            goal_pose="{end_goal_pose}"
                            action_name="navigate_to_pose"/>
                </RateController>
              </ReactiveSequence>
            </WhileDoElse>
          </WhileDoElse>
          <ReactiveSequence>
            <RobotControl stop_gimbal_scan="True"
                          chassis_spin_vel="0.0"
                          scan_enabled="True"
                          allow_vision_control="True"
                          search_when_target_lost="True"
                          scan_yaw_rate_deg_s="60.0"
                          search_pitch_deg="-6.0"/>
            <RateController hz="1">
              <SendGoal name="HomeRecoverFight"
                        goal_pose="{start_goal_pose}"
                        action_name="navigate_to_pose"/>
            </RateController>
          </ReactiveSequence>
        </WhileDoElse>
        <WhileDoElse name="GameScanning">
          <IsGameTime name="IsGameScan"
                      message="{game_status}"
                      game_progress="3"
                      lower_remain_time="0"
                      higher_remain_time="300"/>
          <WhileDoElse name="ScanHealthy">
            <IsStatusOK message="{robot_status}"
                        hp_threshold="250"
                        heat_threshold="350"/>
            <RobotControl stop_gimbal_scan="True"
                          chassis_spin_vel="0.0"
                          scan_enabled="True"
                          allow_vision_control="True"
                          search_when_target_lost="True"
                          scan_yaw_rate_deg_s="60.0"
                          search_pitch_deg="-6.0"/>
            <ReactiveSequence>
              <RobotControl stop_gimbal_scan="True"
                            chassis_spin_vel="0.0"
                            scan_enabled="True"
                            allow_vision_control="True"
                            search_when_target_lost="True"
                            scan_yaw_rate_deg_s="60.0"
                            search_pitch_deg="-6.0"/>
              <RateController hz="1">
                <SendGoal name="HomeRecoverScan"
                          goal_pose="{start_goal_pose}"
                          action_name="navigate_to_pose"/>
              </RateController>
            </ReactiveSequence>
          </WhileDoElse>
          <RobotControl stop_gimbal_scan="True"
                        chassis_spin_vel="0.0"
                        scan_enabled="False"
                        allow_vision_control="False"
                        search_when_target_lost="False"
                        scan_yaw_rate_deg_s="0.0"
                        search_pitch_deg="-6.0"/>
        </WhileDoElse>
      </WhileDoElse>
    </ReactiveSequence>
  </BehaviorTree>

  <TreeNodesModel>
    <Action ID="GetCurrentLocation"
            editable="true">
      <output_port name="current_location"
                   default="{current_location}"/>
    </Action>
    <Action ID="IsDetectEnemy"
            editable="true">
      <input_port name="message"
                  default="{armors}"/>
    </Action>
    <Action ID="IsGameTime"
            editable="true">
      <input_port name="message"
                  default="{game_status}"/>
      <input_port name="game_progress"
                  default="4"/>
      <input_port name="lower_remain_time"
                  default="0"/>
      <input_port name="higher_remain_time"
                  default="300"/>
    </Action>
    <Action ID="IsNearGoal"
            editable="true">
      <input_port name="current_location"
                  default="{current_location}"/>
      <input_port name="goal_pose"
                  default="0;0;0; 0;0;0;1"/>
      <input_port name="dist_threshold"
                  default="0.3"/>
    </Action>
    <Action ID="IsStatusOK"
            editable="true">
      <input_port name="message"
                  default="{robot_status}"/>
      <input_port name="hp_threshold"
                  default="100"/>
      <input_port name="heat_threshold"
                  default="350"/>
    </Action>
    <Decorator ID="RateController">
      <input_port name="hz">Rate</input_port>
    </Decorator>
    <Action ID="RobotControl"
            editable="true">
      <input_port name="stop_gimbal_scan"
                  default="True"/>
      <input_port name="chassis_spin_vel"
                  default="0.0"/>
      <input_port name="scan_enabled"
                  default="False"/>
      <input_port name="allow_vision_control"
                  default="False"/>
      <input_port name="search_when_target_lost"
                  default="False"/>
      <input_port name="scan_yaw_rate_deg_s"
                  default="0.0"/>
      <input_port name="search_pitch_deg"
                  default="0.0"/>
    </Action>
    <Action ID="SendGoal"
            editable="true">
      <input_port name="goal_pose"
                  default="0;0;0; 0;0;0;1"/>
      <input_port name="action_name"
                  default="navigate_to_pose"/>
    </Action>
    <Action ID="SubArmors"
            editable="true">
      <input_port name="topic_name"
                  default="/detector/armors"/>
      <output_port name="armors"
                   default="{armors}"/>
    </Action>
    <Action ID="SubGameStatus"
            editable="true">
      <input_port name="topic_name"
                  default="game_status"/>
      <output_port name="game_status"
                   default="{game_status}"/>
    </Action>
    <Action ID="SubRobotStatus"
            editable="true">
      <input_port name="topic_name"
                  default="robot_status"/>
      <output_port name="robot_status"
                   default="{robot_status}"/>
    </Action>
  </TreeNodesModel>
</root>
