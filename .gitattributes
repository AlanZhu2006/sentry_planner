# 跨平台换行符配置
# 确保Windows和Mac/Linux之间代码共享不会出现换行符问题

# 默认使用LF（Unix风格）
* text=auto eol=lf

# 源代码文件强制使用LF
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.s text eol=lf
*.S text eol=lf

# 配置文件使用LF
*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.conf text eol=lf

# 构建文件使用LF
Makefile text eol=lf
*.mk text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf

# 文档文件使用LF
*.md text eol=lf
*.txt text eol=lf
*.rst text eol=lf

# Shell脚本使用LF
*.sh text eol=lf
*.bash text eol=lf

# Windows批处理文件使用CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件不做转换
*.bin binary
*.hex binary
*.elf binary
*.o binary
*.a binary
*.lib binary
*.so binary
*.dll binary
*.dylib binary
*.exe binary

# 图片文件
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary

# 其他二进制格式
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.7z binary
*.rar binary
